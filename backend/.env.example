# Copia este archivo a .env y completa los valores. NUNCA subas .env a Git.
PORT=3000
NODE_ENV=development

DB_HOST=localhost
DB_PORT=3306
DB_USER=avaluos_app
DB_PASSWORD=
DB_NAME=avaluos

# Cadena larga y aleatoria. Generala con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# P-07: true = la asistente ve todas las solicitudes.
ASISTENTE_ACCESO_GLOBAL=true

# Contrasena de las cuentas demo (minimo 12 caracteres). Si lleva #, ponla entre comillas.
SEED_PASSWORD=
